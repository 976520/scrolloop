{
  "name": "@scrolloop/vue",
  "version": "0.1.0",
  "description": "Vue 3 adapter for @scrolloop/core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "size": "size-limit",
    "lint:publint": "publint --strict",
    "lint:attw": "attw --pack --profile node16 --exclude-entrypoints ./style.css",
    "lint:package": "pnpm run lint:publint && pnpm run lint:attw"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@scrolloop/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "unplugin-vue": "7.2.0",
    "vue": "^3.3.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
